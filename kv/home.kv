<HomeScreen>:
    md_bg_color: 0.05, 0.055, 0.10, 1
    
    MDBoxLayout:
        orientation: 'vertical'
        padding: "20dp"
        spacing: "20dp"
        
        # Title area
        MDBoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: "80dp"
            
            MDLabel:
                text: "ConnekTor"
                font_style: "H4"
                bold: True
                theme_text_color: "Custom"
                text_color: app.accent_color_rgba
                halign: "center"
                
            MDLabel:
                text: "College WiFi, automated."
                theme_text_color: "Custom"
                text_color: 0.557, 0.557, 0.627, 1
                halign: "center"
                
        # Status Pill
        MDBoxLayout:
            size_hint_y: None
            height: "40dp"
            size_hint_x: None
            width: "150dp"
            pos_hint: {"center_x": .5}
            md_bg_color: root.status_color
            radius: [20,]
            
            MDLabel:
                text: root.status_text
                halign: "center"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                bold: True
                
        # Connect Button
        MDRelativeLayout:
            size_hint_y: 1
            
            MDFloatingActionButton:
                id: connect_btn
                icon: "wifi"
                type: "large"
                pos_hint: {"center_x": .5, "center_y": .5}
                md_bg_color: root.btn_color
                on_release: root.start_login()
                theme_icon_color: "Custom"
                icon_color: 1, 1, 1, 1
                elevation: 4
                
        # Active Profile Card
        MDCard:
            size_hint_y: None
            height: "80dp"
            md_bg_color: 0.086, 0.094, 0.16, 1
            radius: [15,]
            padding: "15dp"
            on_release: root.cycle_profile()
            
            MDBoxLayout:
                orientation: 'vertical'
                
                MDLabel:
                    text: "ACTIVE PROFILE"
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: 0.557, 0.557, 0.627, 1
                    
                MDLabel:
                    text: root.active_profile_name
                    theme_text_color: "Custom"
                    text_color: app.accent_color_rgba
                    bold: True
                    
                MDLabel:
                    text: root.profile_index_text + " — tap to switch"
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: 0.557, 0.557, 0.627, 1
